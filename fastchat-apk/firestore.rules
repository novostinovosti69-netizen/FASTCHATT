rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'mpdsangi@gmail.com'; }
    function isMember(c) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(c)).data.members; }

    match /users/{u} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == u || isAdmin());
      allow delete: if isAdmin();
    }
    match /chats/{c} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members;
      match /messages/{m} {
        allow read: if isMember(c);
        allow create: if isMember(c) && request.resource.data.from == request.auth.uid;
        allow update: if isMember(c) && (resource.data.from == request.auth.uid
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rx']));
      }
      match /media/{m} {
        allow read: if isMember(c);
        allow create: if isMember(c) && request.resource.data.from == request.auth.uid;
        allow delete: if isMember(c) && resource.data.from == request.auth.uid;
      }
    }
  }
}
